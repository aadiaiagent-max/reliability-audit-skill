{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aadiaiagent-max/reliability-audit-skill/skills/reliability-audit/report-schema.json",
  "title": "reliability-audit findings.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "createdAt", "findings"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp"
    },
    "runId": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateId",
        "unitId",
        "status",
        "severity",
        "title",
        "summary",
        "boundary",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "minLength": 1 },
        "unitId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["confirmed", "needs_validation"]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "failureClass": { "type": "string" },
        "impact": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "remediation": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "confirmed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["impact"],
            "properties": {
              "impact": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
